# Copy to .env and adjust as needed. All vars are prefixed AUDIO_SEARCH_
# per src/api/settings.py (pydantic-settings env_prefix).

AUDIO_SEARCH_DATABASE_URL=******localhost:5432/audio_search

# --- Embedding model (semantic search) ---
# provider: "sentence-transformers" (local, default) | "openai-compatible"
# (calls a hosted/self-hosted /v1/embeddings endpoint -- NVIDIA NIM, OpenAI,
# vLLM, Text-Embeddings-Inference, etc. See src/infra/openai_compatible_embedder.py)
AUDIO_SEARCH_EMBEDDING_PROVIDER=sentence-transformers
AUDIO_SEARCH_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Only used when EMBEDDING_PROVIDER=openai-compatible, e.g.:
# AUDIO_SEARCH_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
AUDIO_SEARCH_EMBEDDING_BASE_URL=

# --- Transcription (Whisper) ---
# WHISPER_MODEL_SIZE also accepts a local path / HF repo id for a converted
# checkpoint when the backend is faster-whisper.
AUDIO_SEARCH_WHISPER_MODEL_SIZE=base
AUDIO_SEARCH_TRANSCRIPTION_PRIMARY_BACKEND=faster-whisper
AUDIO_SEARCH_TRANSCRIPTION_FALLBACK_BACKEND=openai-whisper

# --- Answer generation (/search/answer LLM mode, optional) ---
# Any OpenAI-compatible chat-completions endpoint works -- NVIDIA NIM,
# OpenAI, self-hosted vLLM/Ollama, etc. See src/infra/openai_answer_generator.py
AUDIO_SEARCH_ANSWER_MODEL=gpt-4o-mini
# e.g. AUDIO_SEARCH_ANSWER_BASE_URL=https://integrate.api.nvidia.com/v1
AUDIO_SEARCH_ANSWER_BASE_URL=

AUDIO_SEARCH_LOG_LEVEL=INFO
AUDIO_SEARCH_DEFAULT_TOP_K=10
AUDIO_SEARCH_RRF_K=60

# Required only for src/infra/pyannote_diarizer.py (HuggingFace gated model access)
HF_TOKEN=

# Required only when using a real LLM/embedding provider above (OpenAI or
# any OpenAI-compatible endpoint). Safe to leave unset -- falls back
# automatically to ExtractiveAnswerGenerator / sentence-transformers.
# NVIDIA_API_KEY is checked as a fallback if OPENAI_API_KEY is unset
# (convenient when using NVIDIA NIM without renaming the var).
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Set to 1 once Whisper/HF models are cached locally to skip slow online
# cache-validation checks (useful behind a blocking corporate proxy).
HF_HUB_OFFLINE=
